{
  "name": "ksdc-complaints-management",
  "version": "0.1.0",
  "private": true,
  "description": "Karnataka State Dental Council \u2014 complaints register and follow-up engine",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @ksdc/db generate",
    "db:migrate": "pnpm --filter @ksdc/db migrate",
    "db:seed": "pnpm --filter @ksdc/db seed",
    "db:reset": "pnpm --filter @ksdc/db reset",
    "check:vocabulary": "node scripts/check-vocabulary.mjs",
    "check:schema-rls": "pnpm --filter @ksdc/db check:rls",
    "db:dev": "pnpm --filter @ksdc/db dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}