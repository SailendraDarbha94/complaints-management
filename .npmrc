# node-linker=hoisted is NOT optional.
# Expo/Metro (apps/mobile, Phase 6) cannot resolve modules under pnpm's default
# symlinked store. Changing this will cost a day when the mobile app arrives.
# See docs/adr/0001-canonical-schema.md.
node-linker=hoisted
#
# A consequence of that, paid for once on 2026-09-11: with hoisting there is exactly ONE
# copy of react in node_modules, so every workspace that renders must ask for the SAME
# version. apps/mobile pins react 19.2.3 (Expo SDK 57 requires it) and it hoists to the
# root; apps/web asked for ^19.0.0, resolved 19.3.0 into its own node_modules, and `next
# build` then died prerendering its own /404 and /500 with "Cannot read properties of null
# (reading 'useContext')" - two Reacts, two dispatchers. apps/web is therefore pinned to
# 19.2.3 as well. Bump them together or not at all.
strict-peer-dependencies=false
auto-install-peers=true
