# Copy to .env. Expo inlines EXPO_PUBLIC_* into the bundle, so ONLY values that are safe
# in the hands of anyone holding the app belong here.
#
# The SECRET key must never appear in this file or any other file in apps/mobile. It
# bypasses row-level security; in an APK it is one `unzip` away from every council's
# case files.

EXPO_PUBLIC_SUPABASE_URL=https://gicmjqvhhmanitvmpnmk.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The register's own API. Writes go here with a bearer token rather than direct to
# Supabase, because audit.append() takes its actor from settings a direct client never
# sets, and an unattributed write breaks the audit chain.
EXPO_PUBLIC_API_URL=http://localhost:3000
