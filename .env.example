# Copy to .env.dev (gitignored) for local development. The API reads that file
# automatically; in production these come from Secret Manager and the environment.

DATABASE_URL=postgres://app_rw:app_rw_dev@localhost:55432/ksdc_dev

# From: pnpm --filter @ksdc/api keys
# Paste the printed lines verbatim - the escaped newlines are handled.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# console writes sign-in codes to the log and apps/api/var/mail/outbox.log.
# smtp needs SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS / MAIL_FROM.
MAIL_TRANSPORT=console

WEB_ORIGIN=http://localhost:3000
PORT=8080
