{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "tsconfig.base.json",
    ".env"
  ],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "API_URL",
    "API_PUBLIC_URL",
    "NEXT_PUBLIC_API_URL",
    "JWT_PRIVATE_KEY",
    "JWT_PUBLIC_KEY",
    "MAIL_TRANSPORT",
    "STORAGE_DRIVER",
    "STORAGE_ROOT",
    "STORAGE_SIGNING_SECRET",
    "GCS_BUCKET_DOCUMENTS",
    "AUTH_DRIVER",
    "SUPABASE_URL",
    "SUPABASE_SERVICE_ROLE_KEY",
    "SUPABASE_STORAGE_BUCKET",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "SCHEDULER_AUDIENCE",
    "SUPABASE_SECRET_KEY",
    "SUPABASE_PUBLISHABLE_KEY",
    "SUPABASE_DB_URL",
    "SUPABASE_APP_DB_URL",
    "NEXT_PUBLIC_SUPABASE_URL",
    "SCHEDULER_SECRET",
    "EXPO_PUBLIC_SUPABASE_URL",
    "EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
    "EXPO_PUBLIC_API_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ]
    }
  }
}
